include armv7-r/Make.defs

# When built under PX4, TOPDIR/Make.defs is PX4's own file, which (unlike a
# stock NuttX board scripts/Make.defs) does not include Toolchain.defs, so
# CELFFLAGS is left empty. crt0.c is compiled with $(CELFFLAGS) and is a
# prerequisite of libarch.a even for CONFIG_BUILD_FLAT, so without the include
# path it fails to find <nuttx/config.h>. Fall back to $(CFLAGS) here; in a
# stock NuttX build Toolchain.defs has already set CELFFLAGS so this no-ops.
CELFFLAGS ?= $(CFLAGS)

# For the PX4 (archive-only) link, the vector-table object arm_vectortab.o -
# which defines the ENTRY symbol _vector_start - must live inside libarch.a
# rather than being a separately-linked HEAD object (PX4 links only the NuttX
# archives, not HEAD_OBJ). Move it from HEAD_ASRC into the common sources so
# EXTERN(_vector_start)/KEEP(*(.vectors)) in script.ld can pull and place it.
HEAD_ASRC := $(filter-out arm_vectortab.S,$(HEAD_ASRC))
CMN_ASRCS += arm_vectortab.S

LDFLAGS += --entry=_vector_start

CHIP_CSRCS += am67_boot.c
CHIP_CSRCS += am67_irq.c
CHIP_CSRCS += am67_mpuinit.c
CHIP_CSRCS += am67_pinmux.c
CHIP_CSRCS += am67_serial.c
CHIP_CSRCS += am67_timer.c
CHIP_CSRCS += am67_tisci.c
ifeq ($(CONFIG_AM67_GPIO),y)
CHIP_CSRCS += am67_gpio.c
endif
ifeq ($(CONFIG_AM67_EPWM0),y)
CHIP_CSRCS += am67_pwm.c
endif
ifneq ($(filter y,$(CONFIG_AM67_ECAP0) $(CONFIG_AM67_ECAP1) $(CONFIG_AM67_ECAP2)),)
CHIP_CSRCS += am67_ecap.c
endif
ifeq ($(CONFIG_AM67_MCSPI0),y)
CHIP_CSRCS += am67_mcspi.c
endif
ifeq ($(CONFIG_AM67_I2C),y)
CHIP_CSRCS += am67_i2c.c
endif
ifeq ($(CONFIG_RPTUN),y)
CHIP_CSRCS += am67_rptun.c
endif
ifeq ($(CONFIG_AM67_RTI8_WDT),y)
CHIP_CSRCS += am67_rti.c
endif
ifeq ($(CONFIG_AM67_DSHOT),y)
CHIP_CSRCS += am67_dshot.c
CHIP_ASRCS += am67_dshot_fiq.S
endif

ifeq ($(CONFIG_AM67_SDHCI0),y)
CHIP_CSRCS += am67_sdhci.c
endif
CHIP_CSRCS += am67_rat.c
