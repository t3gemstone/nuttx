include armv7-r/Make.defs

# AM67A MCU Domain uses custom TCMA boot vector table as HEAD object

HEAD_ASRC = am67a_mcu_tcma_boot.S

CHIP_CSRCS = am67a_mcu_boot.c am67a_mcu_mpuinit.c am67a_mcu_lowputc.c \
             am67a_mcu_irq.c am67a_mcu_timer.c

ifeq ($(CONFIG_RPTUN),y)
CHIP_CSRCS += am67a_mcu_rptun.c am67a_mcu_rsc_table.c
endif

ifneq ($(filter y,$(CONFIG_AM67A_MCU_MCSPI0) $(CONFIG_AM67A_MCU_MCSPI1)),)
CHIP_CSRCS += am67a_mcu_mcspi.c
endif

ifeq ($(CONFIG_AM67A_MCU_I2C0),y)
CHIP_CSRCS += am67a_mcu_i2c.c
endif

ifeq ($(CONFIG_AM67A_MCU_EPWM),y)
CHIP_CSRCS += am67a_mcu_pwm.c
endif

ifeq ($(CONFIG_AM67A_MCU_HRT),y)
CHIP_CSRCS += am67a_mcu_hrt.c
endif

ifeq ($(CONFIG_ARM_MPU),y)
CHIP_CSRCS += arm_mpu.c
endif

# RemoteProc expects entry point at TCMA vector start (0x00000000)

LDFLAGS += --entry=_vector_start
